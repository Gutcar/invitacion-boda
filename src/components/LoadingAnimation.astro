<!-- The full-page loading overlay -->
<div
  id="loading-screen"
  style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; display: grid; place-items: center; z-index: 9999; background: #484044;"
>
  <div
    style="display: flex; align-items: center; font-family: sans-serif; color: #f6f6f6;"
  >
    <svg
      class="mr-3 size-5 animate-spin"
      viewBox="0 0 24 24"
      style="width: 1.25rem; height: 1.25rem;"
    >
      <circle
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        stroke-width="4"
        fill="none"
        stroke-dasharray="31.415, 31.415"
        stroke-dashoffset="0"></circle>
    </svg>
    Cargando...
  </div>
</div>
